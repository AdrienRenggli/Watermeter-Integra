#include <Arduino.h>
#include <SPI.h>
#include <MFRC522.h>
#include <WiFi.h>
#include <PubSubClient.h>
#include <ArduinoJson.h>

// --- Configuration ---
const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

const char* MQTT_SERVER = "192.168.1.XXX";
const int   MQTT_PORT = 1883;
const char* MQTT_USER = "YOUR_MQTT_USER";
const char* MQTT_PASSWORD = "YOUR_MQTT_PASSWORD";

// --- Pins & Hardware ---
#define RST_PIN 22
#define SS_PIN 5
#define PULSE_PIN 27
MFRC522 mfrc522(SS_PIN, RST_PIN);
WiFiClient espClient;
PubSubClient mqttClient(espClient);

// --- State Variables ---
const float LITERS_PER_PULSE = 10.0;
volatile unsigned long pulseCount = 0;
volatile unsigned long lastInterruptTime = 0;

unsigned long lastProcessedPulses = 0;
unsigned long pulsesAtLastNfcRead = 0;

float coldWaterLiters = 0.0;
float hotWaterLiters = 0.0;
float lastTotalLiters = -1.0; // -1 means no NFC read yet

unsigned long lastNfcScanTime = 0;
const unsigned long NFC_SCAN_INTERVAL = 10000; // 10 seconds

// --- Interrupt Routine ---
void IRAM_ATTR handlePulse() {
  unsigned long interruptTime = millis();
  if (interruptTime - lastInterruptTime > 50) { // 50ms debounce
    pulseCount++;
  }
  lastInterruptTime = interruptTime;
}

void setupWiFi() {
  Serial.print("Connecting to WiFi...");
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  delay(100);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected.");
}

void reconnectMQTT() {
  while (!mqttClient.connected()) {
    Serial.print("Connecting to MQTT...");
    if (mqttClient.connect("ESP32_WaterSystem", MQTT_USER, MQTT_PASSWORD)) {
      Serial.println("connected.");
      
      String devJson = "\"device\": {\"identifiers\": [\"aqua_system\"], \"name\": \"Aquastream System\", \"manufacturer\": \"Integra\"}";
      
      // Total Water (NFC)
      String totCfg = "{\"name\": \"Total Water\", \"state_topic\": \"ha/water/state\", \"unit_of_measurement\": \"L\", \"device_class\": \"water\", \"state_class\": \"total_increasing\", \"value_template\": \"{{ value_json.total_l }}\", \"unique_id\": \"ws_tot_01\", " + devJson + "}";
      mqttClient.publish("homeassistant/sensor/ws_total/config", totCfg.c_str(), true);

      // Cold Water (Pulse)
      String cldCfg = "{\"name\": \"Cold Water\", \"state_topic\": \"ha/water/state\", \"unit_of_measurement\": \"L\", \"device_class\": \"water\", \"state_class\": \"total_increasing\", \"value_template\": \"{{ value_json.cold_l }}\", \"unique_id\": \"ws_cld_01\", " + devJson + "}";
      mqttClient.publish("homeassistant/sensor/ws_cold/config", cldCfg.c_str(), true);

      // Hot Water (Calculated)
      String hotCfg = "{\"name\": \"Hot Water\", \"state_topic\": \"ha/water/state\", \"unit_of_measurement\": \"L\", \"device_class\": \"water\", \"state_class\": \"total_increasing\", \"value_template\": \"{{ value_json.hot_l }}\", \"unique_id\": \"ws_hot_01\", " + devJson + "}";
      mqttClient.publish("homeassistant/sensor/ws_hot/config", hotCfg.c_str(), true);
    } else {
      Serial.print("failed, rc=");
      Serial.print(mqttClient.state());
      Serial.println(" retrying in 5 seconds");
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);

  Serial.println("Booting...");
  
  pinMode(PULSE_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(PULSE_PIN), handlePulse, FALLING);
  
  setupWiFi();
  mqttClient.setBufferSize(1024);
  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
  
  SPI.begin();
  mfrc522.PCD_Init();
  mfrc522.PCD_SetAntennaGain(mfrc522.RxGain_max);

  Serial.println("System is ready!");
}

void loop() {
  if (!mqttClient.connected()) reconnectMQTT();
  mqttClient.loop();

  // 1. PROCESS COLD WATER PULSES INSTANTLY
  noInterrupts();
  unsigned long currentPulses = pulseCount;
  interrupts();

  if (currentPulses != lastProcessedPulses) {
    coldWaterLiters = currentPulses * LITERS_PER_PULSE;
    lastProcessedPulses = currentPulses;
    Serial.print("Cold Pulse! Total Cold: ");
    Serial.println(coldWaterLiters);
    
    // Optional: Publish instantly on pulse, or let the 10s NFC loop publish everything together.
  }

  // 2. PROCESS NFC TOTAL & CALCULATE HOT WATER (Every 10 seconds)
  if (millis() - lastNfcScanTime >= NFC_SCAN_INTERVAL) {
    lastNfcScanTime = millis();
    
    mfrc522.PCD_AntennaOff(); 
    delay(50);
    mfrc522.PCD_AntennaOn();  
    delay(50);

    bool tagFound = false;
    unsigned long scanStart = millis();
    while (millis() - scanStart < 1000) {
      if (mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial()) {
        tagFound = true; 
        break;
      }
      yield();
    }

    if (tagFound) {
      byte buf[18]; byte sz = sizeof(buf);
      if (mfrc522.MIFARE_Read(14, buf, &sz) == MFRC522::STATUS_OK) {
        uint32_t currentTotalLiters = ((uint32_t)buf[3] << 24) | ((uint32_t)buf[2] << 16) | 
                                      ((uint32_t)buf[1] << 8)  | (uint32_t)buf[0];

        // Only calculate Hot Water if we have a previous baseline to compare against
        if (lastTotalLiters >= 0) {
          float deltaTotal = currentTotalLiters - lastTotalLiters;
          float deltaCold = (currentPulses - pulsesAtLastNfcRead) * LITERS_PER_PULSE;
          
          float deltaHot = deltaTotal - deltaCold;
          if (deltaHot < 0) deltaHot = 0; // Prevent negative math errors
          
          hotWaterLiters += deltaHot;
        }

        lastTotalLiters = currentTotalLiters;
        pulsesAtLastNfcRead = currentPulses;

        // Build and publish JSON
        StaticJsonDocument<256> doc;
        doc["total_l"] = currentTotalLiters;
        doc["cold_l"] = coldWaterLiters;
        doc["hot_l"] = hotWaterLiters;
        
        char jsonBuffer[256];
        serializeJson(doc, jsonBuffer);
        mqttClient.publish("ha/water/state", jsonBuffer);
        
        Serial.print("NFC Sync -> "); Serial.println(jsonBuffer);
        mfrc522.PICC_HaltA();
      }
      mfrc522.PCD_Init(); 
      mfrc522.PCD_SetAntennaGain(mfrc522.RxGain_max);
    }
  }
}